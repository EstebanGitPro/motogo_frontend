#!/usr/bin/env sh

# ==============================================================================
# Pre-commit hook para Flutter/Dart
# Ejecuta validaciones antes de cada commit
# ==============================================================================

echo "🔍 Ejecutando pre-commit hooks para Flutter..."
echo ""

# -----------------------------------------------------------------------------
# 1. Verificar formato de código con dart format
# -----------------------------------------------------------------------------
echo "📝 Verificando formato de código..."

# Verificar si hay archivos .dart modificados
DART_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.dart$' || true)

if [ -n "$DART_FILES" ]; then
    # Verificar el formato de los archivos staged
    if ! dart format --set-exit-if-changed --output=none $DART_FILES 2>/dev/null; then
        echo ""
        echo "❌ Error: Algunos archivos no están formateados correctamente."
        echo "   Ejecuta 'dart format lib/' y vuelve a hacer commit."
        echo ""
        exit 1
    fi
    echo "✅ Formato de código OK"
else
    echo "⏭️  No hay archivos Dart modificados para verificar formato"
fi

echo ""

# -----------------------------------------------------------------------------
# 2. Ejecutar flutter analyze (linting)
# -----------------------------------------------------------------------------
echo "🔍 Ejecutando flutter analyze..."

if ! flutter analyze --no-fatal-infos lib/; then
    echo ""
    echo "❌ Error: flutter analyze encontró problemas."
    echo "   Corrige los errores antes de hacer commit."
    echo ""
    exit 1
fi

echo "✅ Flutter analyze OK"
echo ""

# -----------------------------------------------------------------------------
# 3. Ejecutar tests (opcional, puede comentarse para commits rápidos)
# -----------------------------------------------------------------------------
# Descomentar las siguientes líneas para ejecutar tests en cada commit
# 
# echo "🧪 Ejecutando flutter test..."
# if ! flutter test --no-pub; then
#     echo ""
#     echo "❌ Error: Algunos tests fallaron."
#     echo "   Corrige los tests antes de hacer commit."
#     echo ""
#     exit 1
# fi
# echo "✅ Tests OK"
# echo ""

# -----------------------------------------------------------------------------
# Éxito
# -----------------------------------------------------------------------------
echo "✅ Pre-commit hook ejecutado exitosamente!"
exit 0

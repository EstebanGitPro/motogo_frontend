#!/usr/bin/env sh

# Flag para deshabilitar coverage temporalmente
SKIP_COVERAGE=false

if [ "$SKIP_COVERAGE" = true ]; then
    echo "⚠️ Coverage omitido para commits iniciales"
    echo "✅ Pre-commit hook ejecutado exitosamente!"
    exit 0
fi

# Mensaje inicial
echo "🔍 Ejecutando Flutter Coverage..."

# Ejecutar las pruebas y generar la cobertura
if output=$(flutter test --coverage); then
   echo "$output"

   # Filtrar archivos excluidos de cobertura (alineado con sonar.coverage.exclusions)
   echo "🔧 Filtrando archivos excluidos de cobertura..."
   lcov --remove coverage/lcov.info \
     '*.g.dart' \
     '*.freezed.dart' \
     '*/generated/*' \
     '*.mocks.dart' \
     '*/presentation/*' \
     '*/core/widgets/*' \
     '*/core/injector/*' \
     '*/core/services/*' \
     -o coverage/lcov_filtered.info \
     --ignore-errors unused \
     2>&1

   # Generar el informe HTML con los datos filtrados
   genhtml_output=$(genhtml coverage/lcov_filtered.info -o coverage/html 2>&1)
   
   # Extraer solo la línea del resumen total (última línea con "lines")
   # Formato esperado: "  lines......: 81.7% (1234 of 1510 lines)"
   coverage=$(echo "$genhtml_output" | grep -E "^\s*lines" | tail -1 | sed 's/.*: //' | sed 's/%.*//' | tr -d '.')
   
   if [ -z "$coverage" ]; then
       echo "❌ Error al obtener la cobertura"
       echo "Output de genhtml:"
       echo "$genhtml_output"
       exit 1
   fi

   # Convertir a formato legible (817 -> 81.7)
   coverage_display=$(echo "scale=1; $coverage / 10" | bc)
   echo "📊 Porcentaje de cobertura: ${coverage_display}%"

   # Verificar umbral de 80%
   if [ "$coverage" -lt 800 ]; then
       echo "❌ La cobertura (${coverage_display}%) es inferior al 80%"
       exit 1
   fi

   echo "✅ Cobertura OK (≥80%)"

   # Abrir el informe (macOS compatible)
   open coverage/html/index.html 2>/dev/null || echo "⚠️ Abra manualmente: coverage/html/index.html"
   
   echo "✅ Coverage ejecutado exitosamente!"
   exit 0
else
   echo "❌ Fallo en Flutter Coverage: $output"
   exit 1
fi
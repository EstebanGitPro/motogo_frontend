# MotoGo Frontend - Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# Backend API (default: http://localhost:8085/motogo/api/v1)
# Uncomment and change if your backend runs on a different host/port
# BASE_URL=http://localhost:8085/motogo/api/v1

# Mapbox
MAPBOX_ACCESS_TOKEN=your_mapbox_token_here

# Firebase (if needed)
# FIREBASE_API_KEY=your_firebase_api_key
